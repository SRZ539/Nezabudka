<Window x:Class="Nezabudka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Nezabudka.App.Localization"
        xmlns:controls="clr-namespace:Nezabudka.App.Controls"
        xmlns:viewModels="clr-namespace:Nezabudka.App.ViewModels"
        mc:Ignorable="d"
        Title="{loc:Loc AppName}"
        FontFamily="{DynamicResource InterfaceFont}"
        FontSize="15"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/nezabudka.ico"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="74"
                            ResizeBorderThickness="7"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame"
                Margin="10"
                Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.48"
                                  Color="#99000000" />
            </Border.Effect>

            <Grid x:Name="AppSurface" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <controls:ParticleField Grid.RowSpan="3"
                                        Margin="10"
                                        Opacity="0.72" />

                <Rectangle Grid.RowSpan="3"
                           Width="610"
                           Height="610"
                           Margin="0,68,34,-26"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource TextBrush}"
                           IsHitTestVisible="False"
                           Opacity="0.06">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="Assets/anime-lineart.png"
                                    Stretch="Uniform"
                                    AlignmentX="Right"
                                    AlignmentY="Bottom" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <Border Grid.Row="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="17,17,0,0">
                    <Grid Margin="20,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="✓"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc AppName}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc AppSubtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="ThemeSelector" Grid.Column="1"
                                Margin="24,0,0,0"
                                Padding="10,6"
                                Style="{StaticResource GlassCard}"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Theme}" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <RadioButton GroupName="Theme"
                                             Style="{StaticResource ThemeRadio}"
                                             IsChecked="{Binding IsWhiteTheme, Mode=TwoWay}"
                                             PreviewMouseLeftButtonDown="ThemeRadio_PreviewMouseLeftButtonDown"
                                             Checked="ThemeRadio_Checked"
                                             ToolTip="{loc:Loc ThemeWhite}">
                                    <Ellipse Width="14" Height="14" Fill="#FFF7F8FC" Stroke="#FFBAC2D0" StrokeThickness="1" />
                                </RadioButton>
                                <RadioButton GroupName="Theme"
                                             Style="{StaticResource ThemeRadio}"
                                             IsChecked="{Binding IsPinkTheme, Mode=TwoWay}"
                                             PreviewMouseLeftButtonDown="ThemeRadio_PreviewMouseLeftButtonDown"
                                             Checked="ThemeRadio_Checked"
                                             ToolTip="{loc:Loc ThemePink}">
                                    <Ellipse Width="14" Height="14" Fill="#FFFF5FA2" />
                                </RadioButton>
                                <RadioButton GroupName="Theme"
                                             Style="{StaticResource ThemeRadio}"
                                             IsChecked="{Binding IsBlackTheme, Mode=TwoWay}"
                                             PreviewMouseLeftButtonDown="ThemeRadio_PreviewMouseLeftButtonDown"
                                             Checked="ThemeRadio_Checked"
                                             ToolTip="{loc:Loc ThemeBlack}">
                                    <Ellipse Width="14" Height="14" Fill="#FF111722" Stroke="#FF70798A" StrokeThickness="1" />
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Button x:Name="CalculatorButton" Grid.Column="3"
                                Height="40"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}"
                                Click="Calculator_Click"
                                ToolTip="{loc:Loc OpenCalculator}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌗" FontSize="19" Margin="0,-2,7,0" />
                                <TextBlock Text="{loc:Loc Calculator}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Grid Grid.Column="2"
                              Margin="8,0,0,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ToggleButton x:Name="DataMenuButton"
                                          Width="40"
                                          Height="40"
                                          Content="⚙"
                                          Style="{StaticResource TogglePill}"
                                          ToolTip="{loc:Loc DataManagement}" />
                            <Popup x:Name="DataMenuPopup"
                                   IsOpen="{Binding IsChecked, ElementName=DataMenuButton, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=DataMenuButton}"
                                   Placement="Bottom"
                                   VerticalOffset="8"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="360"
                                        Padding="16"
                                        Style="{StaticResource GlassCard}"
                                        Background="{DynamicResource ElevatedBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc DataManagement}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc DataFolder}" Margin="0,11,0,3" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding DataDirectory}"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding DataDirectory}" />
                                        <UniformGrid Columns="2" Margin="0,13,0,10">
                                            <Button Content="{loc:Loc ExportNotes}" Margin="0,0,4,0" Style="{StaticResource GhostButton}" Click="ExportNotes_Click" />
                                            <Button Content="{loc:Loc ImportNotes}" Margin="4,0,0,0" Style="{StaticResource GhostButton}" Click="ImportNotes_Click" />
                                        </UniformGrid>
                                        <Button Content="{loc:Loc ChangeDataFolder}" Style="{StaticResource GhostButton}" Click="ChangeDataFolder_Click" />
                                        <Separator Margin="0,10" />
                                        <Expander Header="{Binding TrashHeader}" Margin="2,0,2,10">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{loc:Loc TrashEmpty}"
                                                           Margin="4,5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Visibility="{Binding HasDeletedNotes, Converter={StaticResource InverseBooleanToVisibility}}" />
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DeletedNotes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type viewModels:NoteItemViewModel}">
                                                                <Grid Margin="3,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="1"
                                                                            Content="{loc:Loc RestoreNote}"
                                                                            Margin="7,0,0,0"
                                                                            Padding="8,5"
                                                                            Style="{StaticResource GhostButton}"
                                                                            Click="RestoreTrashNote_Click" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Button Content="{loc:Loc EmptyTrash}"
                                                        Margin="0,7,0,0"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        Style="{StaticResource GhostButton}"
                                                        IsEnabled="{Binding HasDeletedNotes}"
                                                        Click="EmptyTrash_Click" />
                                            </StackPanel>
                                        </Expander>
                                        <ToggleButton Content="{loc:Loc AutosaveSetting}"
                                                      Margin="0,0,0,7"
                                                      HorizontalContentAlignment="Left"
                                                      Style="{StaticResource TogglePill}"
                                                      IsChecked="{Binding IsAutoSaveEnabled, Mode=TwoWay}" />
                                        <ToggleButton Content="{loc:Loc GlobalHotkeysSetting}"
                                                      HorizontalContentAlignment="Left"
                                                      Style="{StaticResource TogglePill}"
                                                      IsChecked="{Binding IsGlobalHotkeysEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{loc:Loc GlobalHotkeysHint}"
                                                   Margin="4,7,0,0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button x:Name="NewNoteButton" Grid.Column="4"
                                Height="40"
                                Margin="0,0,12,0"
                                Padding="13,7"
                                VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButton}"
                                Click="NewNote_Click"
                                ToolTip="{loc:Loc NewNoteShortcut}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="18" Margin="0,-2,7,0" />
                                <TextBlock Text="{loc:Loc NewNote}" />
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="WindowButtons" Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="{loc:Loc Minimize}" />
                            <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="{loc:Loc Maximize}">
                                <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource TitleBarButton}"
                                    Content="×"
                                    FontSize="19"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Click="Close_Click"
                                    ToolTip="{loc:Loc MinimizeToTray}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="12,12,6,12"
                            Padding="16"
                            Style="{StaticResource GlassCard}"
                            Background="{DynamicResource SidebarBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="4,0,4,12">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource HoverBrush}"
                                        CornerRadius="8"
                                        Padding="7,2">
                                    <TextBlock Text="{Binding VisibleNoteCount}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                </Border>
                                <TextBlock Text="{loc:Loc MyNotes}" FontSize="15" FontWeight="SemiBold" />
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource InputTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Loc SearchTooltip}" />
                                <TextBlock Text="{loc:Loc SearchPlaceholder}"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="NotesList"
                                         ItemsSource="{Binding NotesView}"
                                         SelectedItem="{Binding SelectedNote}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.PanningMode="VerticalOnly"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseWheel="NotesList_PreviewMouseWheel"
                                         SelectionChanged="NotesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="NoteItem_PreviewMouseRightButtonDown" />
                                            <EventSetter Event="MouseDoubleClick" Handler="NoteItem_MouseDoubleClick" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="11"
                                                                Padding="13,11"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                                                                    <TranslateTransform x:Name="ItemTranslate" />
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         From="0"
                                                                                         To="1"
                                                                                         Duration="0:0:0.3">
                                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemTranslate"
                                                                                         Storyboard.TargetProperty="Y"
                                                                                         From="9"
                                                                                         To="0"
                                                                                         Duration="0:0:0.3">
                                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="MouseEnter">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemTranslate" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.22">
                                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.07" />
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.07" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="MouseLeave">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" />
                                                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" />
                                                                        <DoubleAnimation Storyboard.TargetName="ItemTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:NoteItemViewModel}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontWeight="SemiBold"
                                                               FontSize="15"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTerminal}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Opacity" Value="0.62" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="◆"
                                                               Margin="8,0,0,0"
                                                               FontFamily="Segoe UI Symbol"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               ToolTip="{loc:Loc Pinned}"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibility}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Preview}"
                                                           Margin="0,5,0,7"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="20" />
                                                <TextBlock Text="{Binding ListMeta}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WaitingBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Visibility="{Binding HasVisibleNotes, Converter={StaticResource InverseBooleanToVisibility}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="⌕" FontSize="34" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc NothingFound}" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <TextBlock Text="{loc:Loc Language}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="4,0,0,6" />
                                <Border Style="{StaticResource GlassCard}" Padding="4">
                                    <UniformGrid Columns="3" ToolTip="{loc:Loc LanguageTooltip}">
                                        <RadioButton x:Name="RussianLanguageButton" GroupName="Language"
                                                     Content="RU" IsChecked="{Binding IsRussian, Mode=TwoWay}"
                                                     ToolTip="{loc:Loc LanguageRussian}" Style="{StaticResource LanguageRadio}" />
                                        <RadioButton x:Name="EnglishLanguageButton" GroupName="Language"
                                                     Content="EN" IsChecked="{Binding IsEnglish, Mode=TwoWay}"
                                                     ToolTip="{loc:Loc LanguageEnglish}" Style="{StaticResource LanguageRadio}" />
                                        <RadioButton x:Name="ChineseLanguageButton" GroupName="Language"
                                                     Content="中文" IsChecked="{Binding IsChinese, Mode=TwoWay}"
                                                     ToolTip="{loc:Loc LanguageChinese}" Style="{StaticResource LanguageRadio}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="6,12,12,12">
                        <Grid x:Name="EditorPanel"
                              Margin="0"
                              Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibility}}">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="EditorTranslate" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource GlassCard}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                    <TextBox x:Name="TitleEditor"
                                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             Background="Transparent"
                                             BorderBrush="Transparent"
                                             FontSize="25"
                                             FontWeight="SemiBold"
                                             Padding="8,8"
                                             ToolTip="{loc:Loc NoteTitleTooltip}" />
                                    <TextBlock Text="{loc:Loc NoteUntitled}" Margin="8,8" FontSize="25"
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNote.Title}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Button Content="◆"
                                                Width="38"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Padding="0"
                                                FontFamily="Segoe UI Symbol"
                                                Style="{StaticResource GhostButton}"
                                                Click="PinSelectedNote_Click"
                                                ToolTip="{Binding SelectedNote.PinActionDisplay}" />
                                        <Grid Margin="0,0,8,0">
                                            <ToggleButton x:Name="StatusPickerButton"
                                                          Style="{StaticResource TogglePill}"
                                                          IsChecked="{Binding IsStatusPickerOpen, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding SelectedNote.StatusDisplay}" />
                                                    <TextBlock Text="⌄" Margin="7,-1,0,0" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsStatusPickerOpen, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=StatusPickerButton}"
                                                   Placement="Bottom"
                                                   PopupAnimation="Fade"
                                                   VerticalOffset="7"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Width="176"
                                                        Padding="6"
                                                        Style="{StaticResource GlassCard}"
                                                        Background="{DynamicResource ElevatedBrush}">
                                                    <StackPanel>
                                                        <Button Content="{loc:Loc StatusActive}" Tag="Active" HorizontalContentAlignment="Left" Style="{StaticResource GhostButton}" Click="StatusButton_Click" />
                                                        <Button Content="{loc:Loc StatusWaiting}" Tag="Waiting" HorizontalContentAlignment="Left" Foreground="{DynamicResource WaitingBrush}" Style="{StaticResource GhostButton}" Click="StatusButton_Click" />
                                                        <Button Content="{loc:Loc StatusCompleted}" Tag="Completed" HorizontalContentAlignment="Left" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource GhostButton}" Click="StatusButton_Click" />
                                                        <Button Content="{loc:Loc StatusClosed}" Tag="Closed" HorizontalContentAlignment="Left" Foreground="{DynamicResource MutedBrush}" Style="{StaticResource GhostButton}" Click="StatusButton_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button Content="{loc:Loc Delete}"
                                                Style="{StaticResource GhostButton}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Click="DeleteNote_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,12"
                                    Style="{StaticResource GlassCard}"
                                    Background="{DynamicResource EditorBrush}">
                                <TextBox x:Name="ContentEditor"
                                         Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"
                                         SelectionChanged="ContentEditor_SelectionChanged"
                                         FontFamily="{StaticResource BodyFont}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="0"
                                         Padding="22"
                                         FontSize="16"
                                         TextBlock.LineHeight="25"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         SpellCheck.IsEnabled="True" />
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="16,13">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Reminder}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc ReminderHint}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SaveStatus}"
                                               MaxWidth="155" TextWrapping="Wrap" Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" />

                                    <WrapPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,12,0,0"
                                                Orientation="Horizontal">
                                        <ToggleButton Content="{loc:Loc Remind}"
                                                      Width="118"
                                                      Height="38" Margin="0,0,10,7"
                                                      Style="{StaticResource TogglePill}"
                                                      IsChecked="{Binding SelectedNote.HasReminder, Mode=TwoWay}" />
                                        <Grid Margin="0,0,9,7">
                                            <ToggleButton x:Name="DatePickerButton" Width="140" Height="38"
                                                          Style="{StaticResource TogglePill}" ToolTip="{loc:Loc ChooseDate}"
                                                          Content="{Binding SelectedNote.ReminderDateDisplay}" />
                                            <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DatePickerButton}"
                                                   IsOpen="{Binding IsChecked, ElementName=DatePickerButton, Mode=TwoWay}"
                                                   Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Style="{StaticResource GlassCard}" Background="{DynamicResource ElevatedBrush}" Padding="10">
                                                    <StackPanel>
                                                        <Calendar x:Name="ReminderCalendar" BorderThickness="0"
                                                                  FontFamily="{StaticResource BodyFont}"
                                                                  SelectedDate="{Binding SelectedNote.ReminderDate, Mode=TwoWay}"
                                                                  Loaded="ReminderCalendar_Loaded" />
                                                        <Button Content="{loc:Loc Done}" Style="{StaticResource PrimaryButton}"
                                                                Click="DatePickerDone_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <ToggleButton x:Name="TimePickerButton"
                                                          Width="132"
                                                          Height="38"
                                                          Content="{Binding SelectedNote.ReminderTimeDisplay}"
                                                          Style="{StaticResource TogglePill}"
                                                          IsChecked="{Binding IsTimePickerOpen, Mode=TwoWay}"
                                                          ToolTip="{loc:Loc ChooseExactTime}" />
                                            <Popup IsOpen="{Binding IsTimePickerOpen, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=TimePickerButton}"
                                                   Placement="Bottom"
                                                   PopupAnimation="Fade"
                                                   VerticalOffset="7"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Width="278"
                                                        Padding="14"
                                                        Style="{StaticResource GlassCard}"
                                                        Background="{DynamicResource ElevatedBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc ExactTime}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{loc:Loc TimePickerHint}"
                                                                   Margin="0,3,0,10"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedBrush}" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Tag="hour"
                                                                    Background="Transparent"
                                                                    CornerRadius="10"
                                                                    Cursor="ScrollNS"
                                                                    PreviewMouseWheel="TimePart_PreviewMouseWheel"
                                                                    ToolTip="{loc:Loc ScrollHours}">
                                                                <StackPanel>
                                                                    <Button Content="＋" Tag="hour:1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                    <TextBlock Text="{Binding SelectedNote.ReminderHourText}" Margin="0,7" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                                    <Button Content="−" Tag="hour:-1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text=":" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <Border Grid.Column="2"
                                                                    Tag="minute"
                                                                    Background="Transparent"
                                                                    CornerRadius="10"
                                                                    Cursor="ScrollNS"
                                                                    PreviewMouseWheel="TimePart_PreviewMouseWheel"
                                                                    ToolTip="{loc:Loc ScrollMinutes}">
                                                                <StackPanel>
                                                                    <Button Content="＋" Tag="minute:1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                    <TextBlock Text="{Binding SelectedNote.ReminderMinuteText}" Margin="0,7" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                                    <Button Content="−" Tag="minute:-1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text=":" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <Border Grid.Column="4"
                                                                    Tag="second"
                                                                    Background="Transparent"
                                                                    CornerRadius="10"
                                                                    Cursor="ScrollNS"
                                                                    PreviewMouseWheel="TimePart_PreviewMouseWheel"
                                                                    ToolTip="{loc:Loc ScrollSeconds}">
                                                                <StackPanel>
                                                                    <Button Content="＋" Tag="second:1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                    <TextBlock Text="{Binding SelectedNote.ReminderSecondText}" Margin="0,7" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                                    <Button Content="−" Tag="second:-1" Style="{StaticResource GhostButton}" Click="TimeStepButton_Click" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                        <Button Content="{loc:Loc Done}"
                                                                Margin="0,12,0,0"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Click="TimePickerDone_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button Content="{loc:Loc Reset}"
                                                Margin="9,0,0,7" Height="38"
                                                Style="{StaticResource GhostButton}"
                                                Click="ClearReminder_Click"
                                                Visibility="{Binding SelectedNote.HasReminder, Converter={StaticResource BooleanToVisibility}}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Visibility="{Binding SelectedNote, Converter={StaticResource InverseNullToVisibility}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="60" Height="60" Background="{DynamicResource ElevatedBrush}" CornerRadius="18">
                                <TextBlock Text="✎" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc SelectNote}" Margin="0,16,0,5" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc CreateNoteHint}" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CalculatorPanel"
                            Grid.ColumnSpan="2"
                            Width="348"
                            Margin="0,12,24,24"
                            Padding="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="20"
                            Style="{StaticResource GlassCard}"
                            Background="{DynamicResource ElevatedBrush}"
                            Visibility="{Binding IsCalculatorOpen, Converter={StaticResource BooleanToVisibility}}"
                            RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CalculatorScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CalculatorTranslate" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.45" Color="#99000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="112" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="{loc:Loc Calculator}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="×"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Click="CalculatorClose_Click" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,12,0,10"
                                    Padding="14"
                                    Background="{DynamicResource EditorBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Calculator.History}"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Calculator.Display}"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="-4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="C" Tag="C" Style="{StaticResource CalculatorButton}" Foreground="{DynamicResource DangerBrush}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="0" Grid.Column="1" Content="⌫" Tag="⌫" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="0" Grid.Column="2" Content="%" Tag="%" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="0" Grid.Column="3" Content="÷" Tag="÷" Style="{StaticResource CalculatorButton}" Foreground="{DynamicResource AccentBrush}" Click="CalculatorButton_Click" />

                                <Button Grid.Row="1" Grid.Column="0" Content="7" Tag="7" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="1" Grid.Column="1" Content="8" Tag="8" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="1" Grid.Column="2" Content="9" Tag="9" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="1" Grid.Column="3" Content="×" Tag="×" Style="{StaticResource CalculatorButton}" Foreground="{DynamicResource AccentBrush}" Click="CalculatorButton_Click" />

                                <Button Grid.Row="2" Grid.Column="0" Content="4" Tag="4" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="2" Grid.Column="1" Content="5" Tag="5" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="2" Grid.Column="2" Content="6" Tag="6" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="2" Grid.Column="3" Content="−" Tag="−" Style="{StaticResource CalculatorButton}" Foreground="{DynamicResource AccentBrush}" Click="CalculatorButton_Click" />

                                <Button Grid.Row="3" Grid.Column="0" Content="1" Tag="1" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="3" Grid.Column="1" Content="2" Tag="2" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="3" Grid.Column="2" Content="3" Tag="3" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="3" Grid.Column="3" Content="+" Tag="+" Style="{StaticResource CalculatorButton}" Foreground="{DynamicResource AccentBrush}" Click="CalculatorButton_Click" />

                                <Button Grid.Row="4" Grid.Column="0" Content="±" Tag="±" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="4" Grid.Column="1" Content="0" Tag="0" Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="4" Grid.Column="2" Content="{Binding Calculator.DecimalSeparator}" Tag="," Style="{StaticResource CalculatorButton}" Click="CalculatorButton_Click" />
                                <Button Grid.Row="4" Grid.Column="3" Content="=" Tag="=" Style="{StaticResource PrimaryButton}" Margin="4" FontSize="18" Click="CalculatorButton_Click" />
                            </Grid>

                            <Button Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Content="{loc:Loc InsertCalculation}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanInsertCalculation}"
                                    Click="InsertCalculation_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,17,17">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AutoSaveDisplay}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,0" Text="{loc:Loc FooterCredit}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc TrayHint}" TextTrimming="CharacterEllipsis" ToolTip="{loc:Loc TrayHint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="UndoDeletePanel"
                        Grid.RowSpan="3"
                        Panel.ZIndex="80"
                        Margin="0,0,0,48"
                        Padding="14,9"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource GlassCard}"
                        Background="{DynamicResource ElevatedBrush}"
                        Visibility="{Binding CanUndoDelete, Converter={StaticResource BooleanToVisibility}}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="UndoDeleteTranslate" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc NoteMovedToTrash}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Button Content="{loc:Loc UndoDelete}" Style="{StaticResource PrimaryButton}" Click="UndoDelete_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="DeleteConfirmation" Grid.RowSpan="3" Panel.ZIndex="90"
                        Visibility="Collapsed" Background="#88000000" CornerRadius="17">
                    <Border Width="410" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource GlassCard}" Background="{DynamicResource WindowBrush}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc DeleteNoteTitle}" FontSize="23" FontWeight="SemiBold" />
                            <TextBlock x:Name="DeletePrompt" Margin="0,12,0,22" TextWrapping="Wrap" MaxHeight="180"
                                       FontFamily="{StaticResource BodyFont}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CancelDeleteButton" Content="{loc:Loc Cancel}" MinWidth="100" Margin="0,0,8,0"
                                        Style="{StaticResource GhostButton}" Click="CancelDelete_Click" />
                                <Button x:Name="ConfirmDeleteButton" Content="{loc:Loc Delete}" MinWidth="100"
                                        Style="{StaticResource PrimaryButton}" Click="ConfirmDelete_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Image x:Name="ThemeTransitionSnapshot"
                       Grid.RowSpan="3"
                       Panel.ZIndex="100"
                       Stretch="Fill"
                       IsHitTestVisible="False"
                       SnapsToDevicePixels="True"
                       Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
